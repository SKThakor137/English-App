datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  FREE_USER
  PREMIUM_USER
  ADMIN
}

enum CefrLevel {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
  PROFICIENT
}

enum PracticeType {
  SENTENCE
  PARAGRAPH
  STORY
  LISTEN_AND_REPEAT
  FREE_SPEAKING
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ConversationStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum SenderRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id                   String                  @id @default(uuid())
  email                String                  @unique
  passwordHash         String
  role                 UserRole                @default(FREE_USER)
  isEmailVerified      Boolean                 @default(false)
  refreshTokenHash     String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  profile              UserProfile?
  streak               UserStreak?
  subscription         Subscription?
  dailyQuotas          DailyUsageQuota[]
  dailyProgress        UserDailyProgress[]
  practiceSessions     PracticeSession[]
  practiceAttempts     PracticeAttempt[]
  weaknesses           UserWeakness[]
  vocabulary           UserVocabulary[]
  conversationSessions ConversationSession[]
  documents            Document[]
  challengeAttempts    DailyChallengeAttempt[]
}

model UserProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  fullName         String
  avatarUrl        String?
  nativeLanguage   String?
  currentLevel     CefrLevel @default(BEGINNER)
  targetGoal       String?
  dailyGoalMinutes Int       @default(15)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserStreak {
  id             String    @id @default(uuid())
  userId         String    @unique
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String    @id @default(uuid())
  userId               String    @unique
  planTier             UserRole  @default(FREE_USER)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String    @default("ACTIVE")
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyUsageQuota {
  id                 String   @id @default(uuid())
  userId             String
  usageDate          DateTime
  aiFeedbackRequests Int      @default(0)
  audioUploads       Int      @default(0)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, usageDate])
}

model Course {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  description String
  level       CefrLevel
  topic       String
  orderIndex  Int       @default(1)
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lessons     Lesson[]
}

model Lesson {
  id               String      @id @default(uuid())
  courseId         String
  title            String
  description      String?
  orderIndex       Int         @default(1)
  estimatedMinutes Int         @default(10)
  isPublished      Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  course           Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sentences        Sentence[]
  paragraphs       Paragraph[]
  stories          Story[]
}

model Sentence {
  id                String    @id @default(uuid())
  lessonId          String?
  targetText        String
  ipaTranscription  String?
  grammarFocus      String?
  level             CefrLevel @default(BEGINNER)
  audioReferenceUrl String?
  orderIndex        Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lesson            Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
}

model Paragraph {
  id         String   @id @default(uuid())
  lessonId   String
  title      String?
  content    String
  orderIndex Int      @default(1)
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Story {
  id          String         @id @default(uuid())
  lessonId    String
  title       String
  description String?
  orderIndex  Int            @default(1)
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  segments    StorySegment[]
}

model StorySegment {
  id             String  @id @default(uuid())
  storyId        String
  orderIndex     Int     @default(1)
  narrativeText  String
  promptQuestion String?
  story          Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

model PracticeSession {
  id           String            @id @default(uuid())
  userId       String
  practiceType PracticeType      @default(SENTENCE)
  startedAt    DateTime          @default(now())
  completedAt  DateTime?
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts     PracticeAttempt[]
}

model PracticeAttempt {
  id                 String               @id @default(uuid())
  sessionId          String
  userId             String
  practiceType       PracticeType         @default(SENTENCE)
  referenceId        String?
  expectedText       String
  spokenTranscript   String
  audioS3Key         String?
  overallScore       Int                  @default(0)
  accuracyScore      Int                  @default(0)
  pronunciationScore Int                  @default(0)
  fluencyScore       Int                  @default(0)
  wordsPerMinute     Float                @default(0)
  diffMatrix         Json?
  createdAt          DateTime             @default(now())
  session            PracticeSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbackRecord     AiFeedbackRecord?
  phonemeEvaluations PhonemeEvaluation[]
}

model AiFeedbackRecord {
  id               String          @id @default(uuid())
  attemptId        String          @unique
  overallScore     Int
  grammarScore     Int
  fluencyScore     Int
  accuracyScore    Int
  errors           Json
  suggestions      Json
  positiveFeedback String
  createdAt        DateTime        @default(now())
  attempt          PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model PhonemeEvaluation {
  id          String          @id @default(uuid())
  attemptId   String
  word        String
  phoneme     String
  score       Float
  isAccurate  Boolean
  ipaSymbol   String?
  attempt     PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model UserDailyProgress {
  id                 String   @id @default(uuid())
  userId             String
  activityDate       DateTime
  sentencesPracticed Int      @default(0)
  practiceSeconds    Int      @default(0)
  wordsSpoken        Int      @default(0)
  averageAccuracy    Float    @default(0)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityDate])
}

model UserWeakness {
  id               String   @id @default(uuid())
  userId           String
  weaknessType     String
  identifier       String
  errorCount       Int      @default(1)
  lastEncounteredAt DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weaknessType, identifier])
}

model VocabularyWord {
  id               String           @id @default(uuid())
  word             String           @unique
  ipa              String?
  ipaUs            String?
  definition       String
  exampleSentence  String?
  cefrLevel        CefrLevel        @default(BEGINNER)
  audioUrl         String?
  userVocabularies UserVocabulary[]
}

model UserVocabulary {
  id                String         @id @default(uuid())
  userId            String
  wordId            String
  repetitions       Int            @default(0)
  intervalDays      Int            @default(1)
  easeFactor        Float          @default(2.5)
  nextReviewAt      DateTime       @default(now())
  lastReviewedAt    DateTime?
  masteryPercentage Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word              VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
}

model Document {
  id             String          @id @default(uuid())
  userId         String
  title          String
  fileS3Key      String
  status         DocumentStatus  @default(PENDING)
  estimatedLevel CefrLevel?
  totalSentences Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks         DocumentChunk[]
}

model DocumentChunk {
  id              String   @id @default(uuid())
  documentId      String
  chunkIndex      Int
  textContent     String
  targetSentences Json
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model ConversationScenario {
  id           String                @id @default(uuid())
  title        String
  scenarioKey  String                @unique
  systemPrompt String
  personaName  String
  personaRole  String
  cefrLevel    CefrLevel             @default(INTERMEDIATE)
  sessions     ConversationSession[]
}

model ConversationSession {
  id         String                @id @default(uuid())
  userId     String
  scenarioId String
  status     ConversationStatus    @default(ACTIVE)
  turnCount  Int                   @default(0)
  startedAt  DateTime              @default(now())
  endedAt    DateTime?
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario   ConversationScenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  messages   ConversationMessage[]
}

model ConversationMessage {
  id               String              @id @default(uuid())
  sessionId        String
  senderRole       SenderRole
  textContent      String
  audioUrl         String?
  overallTurnScore Int?
  createdAt        DateTime            @default(now())
  session          ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model DailyChallenge {
  id                String                  @id @default(uuid())
  challengeDate     DateTime                @unique
  promptText        String
  targetCefr        CefrLevel               @default(INTERMEDIATE)
  sampleAnswer      String?
  pointsMultiplier  Float                   @default(1.5)
  attempts          DailyChallengeAttempt[]
}

model DailyChallengeAttempt {
  id              String         @id @default(uuid())
  challengeId     String
  userId          String
  score           Int            @default(0)
  durationSeconds Int            @default(0)
  submittedAt     DateTime       @default(now())
  challenge       DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}
