# Server & Port Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/english_platform?schema=public

# Redis & Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expirations
JWT_SECRET=super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production-min-32
JWT_REFRESH_EXPIRES_IN=7d

# S3 / MinIO Object Storage
STORAGE_DRIVER=mock
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=english-audio-uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_PATH_STYLE_ENDPOINT=true

# Speech Recognition & Pronunciation
SPEECH_PROVIDER=mock
OPENAI_API_KEY=mock-key-or-sk-proj
AZURE_SPEECH_KEY=mock-key
AZURE_SPEECH_REGION=eastus

# AI & LLM Services
LLM_PROVIDER=mock
GROQ_API_KEY=mock-groq-key

