{
  "name": "english-speaking-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Ready English Speaking & Communication Practice Platform Monorepo",
  "workspaces": [
    "backend",
    "apps/web",
    "apps/admin"
  ],
  "scripts": {
    "start:all": "bash scripts/run-all.sh",
    "dev:all": "bash scripts/run-all.sh",
    "dev:backend": "npm --workspace=backend run start:dev",
    "dev:web": "npm --workspace=@english-platform/web run dev",
    "dev:admin": "npm --workspace=@english-platform/admin run dev",
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down",
    "mobile:adb": "adb reverse tcp:4000 tcp:4000 && adb devices",
    "mobile:run": "cd mobile && flutter run",
    "build:backend": "npm --workspace=backend run build",
    "build:web": "npm --workspace=@english-platform/web run build",
    "build:admin": "npm --workspace=@english-platform/admin run build",
    "build": "npm run build:backend && npm run build:web && npm run build:admin",
    "prisma:generate": "npm --workspace=backend run prisma:generate",
    "prisma:seed": "npm --workspace=backend run prisma:seed"
  },
  "keywords": [
    "english-learning",
    "speech-recognition",
    "pronunciation",
    "nextjs",
    "nestjs",
    "flutter",
    "ai"
  ],
  "author": "Google Deepmind & Antigravity Engineering",
  "license": "MIT"
}

